# ── Tailscale Funnel（把 AUN 公開成 https://aun.xxx.ts.net）──
# https://login.tailscale.com/admin/settings/keys → Generate auth key
# 只有第一次登入需要；登入後狀態存在 data/tailscale，之後可以清空
TS_AUTHKEY=

# ── Discord 總管 bot（留空則不啟動 bot）──
# Developer Portal → Bot → 開啟 Message Content Intent
AUN_DISCORD_TOKEN=
# 有新的進度摘要時，是否貼到綁定的頻道（不 tag 人）
AUN_DISCORD_POST_SUMMARIES=true

# ── 進度摘要模型（OpenAI 相容；留空 API key 則使用不需要 LLM 的條列摘要）──
AUN_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
AUN_LLM_API_KEY=
# 依序嘗試、逗號分隔：第一個失敗（下架、限流、額度用完）就換下一個
# 目前可用的模型：curl -s https://integrate.api.nvidia.com/v1/models
# 設好後用 docker compose exec aun aun llm-test 確認
AUN_LLM_MODEL=moonshotai/kimi-k3.1-pro,z-ai/glm-5.3-flash

# ── 節奏 ──
# 搭檔的 commit / 進度最快多久附一次到 context（人類結論、直接訊息不受限制）
AUN_PROGRESS_INTERVAL_MINUTES=30
# 閒置多久後自動產生進度摘要（有 commit 或 context 壓縮前也會產生）
AUN_SUMMARY_IDLE_MINUTES=20
